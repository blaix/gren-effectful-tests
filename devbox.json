{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": [
    "gren@0.6.6",
    "nodejs@20",
    "entr@latest",
    "chromedriver@latest",
    "chromium@145"
  ],
  "shell": {
    "scripts": {
      "test": [
        "cd tests && ./test.sh"
      ],
      "watch": [
        "find . -name \"*.gren\" | entr -c devbox run test"
      ],
      "docs": [
        "gren make && gren docs && npx -y --package=gren-packages gren-doc-preview"
      ]
    }
  }
}
